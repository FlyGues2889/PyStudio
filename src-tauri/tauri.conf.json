{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "pystudio",
  "version": "0.2.0",
  "identifier": "com.lvifly.pystudio",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "PyStudio",
        "width": 1024,
        "height": 720,
        "minWidth": 1024,
        "minHeight": 720,
        "fullscreen": false,
        "resizable": true,
        "decorations": false,
        "transparent": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "nsis",
    "icon": [
      "icons/appIcon.ico"
    ],
    "category": "Utility",
    "windows": {
      "nsis": {
        "languages": [
          "SimpChinese"
        ],
        "displayLanguageSelector": true
      }
    }
  }
}
